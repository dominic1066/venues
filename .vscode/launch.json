{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "🚀 Flutter App (Debug)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug"
        },
        {
            "name": "🚀 Flutter App (Release)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "release"
        },
        {
            "name": "🖥️ Flutter App (Windows)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "windows"
        },
        {
            "name": "🍎 Flutter App (macOS)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "macos"
        },
        {
            "name": "📱 Flutter App (iPhone)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "00008110-0016151A0A90401E"
        },
        {
            "name": "🌐 Flutter App (Chrome)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
