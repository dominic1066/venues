        },
        {
            "name": "🌐 Flutter Web (Debug Enhanced)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "flutterMode": "debug",
            "deviceId": "chrome",
            "args": [
                "--web-renderer=html",
                "--dart-define=FLUTTER_WEB_USE_SKIA=false"
            ]
        },
        {
